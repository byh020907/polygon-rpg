{
  "name": "polygon-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "dev:mobile": "pwsh -NoProfile -File scripts/dev.ps1",
    "visual:qa": "node scripts/visual-qa.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm run format:check && npm run test:combat && npm run test:story && npm run test:map && npm run test:growth && npm run test:platform",
    "test:combat": "node scripts/combat-stamina-check.mjs",
    "test:story": "node scripts/story-interaction-check.mjs",
    "test:map": "node scripts/glasswind-spatial-check.mjs && node scripts/academy-field-spatial-check.mjs",
    "test:growth": "node scripts/progression-growth-check.mjs",
    "test:platform": "node scripts/platform-access-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "alpinejs": "3.14.9",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "prettier": "3.9.6"
  }
}
